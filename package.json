{
  "name": "nostromo-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@5": ">=5.0.9 <6",
      "cross-spawn": ">=7.0.6",
      "diff": ">=5.2.2",
      "dompurify": ">=3.4.13",
      "esbuild": ">=0.25.0",
      "glob": ">=10.5.0",
      "js-yaml": ">=4.3.1 <5",
      "lodash-es": ">=4.17.23",
      "mermaid": ">=11.16.1",
      "nanoid@3": ">=3.3.18 <4",
      "postcss": ">=8.5.26",
      "qs": ">=6.14.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "read-yaml-file>js-yaml": "3.15.1",
      "sharp": ">=0.35.0",
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rm -rf node_modules && rm -rf packages/*/node_modules",
    "docs:dev": "pnpm --filter nostromo-ui-docs dev",
    "docs:build": "pnpm --filter nostromo-ui-docs build",
    "docs:serve": "pnpm --filter nostromo-ui-docs start",
    "analyze": "ANALYZE=true turbo run build",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "validate:theme-contrasts": "tsx scripts/validate-theme-contrasts.ts",
    "validate:exports": "tsx scripts/validate-exports.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/publish-package.mjs",
    "prepare": "husky",
    "verify:react-compat": "node scripts/verify-react-compat.mjs"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  }
}
