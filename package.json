{
  "name": "nostromo-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "cross-spawn": ">=7.0.6",
      "esbuild": ">=0.25.0",
      "dompurify": ">=3.4.9",
      "qs": ">=6.14.1",
      "lodash-es": ">=4.17.23",
      "diff": ">=5.2.2",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "mermaid": ">=11.0.0",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rm -rf node_modules && rm -rf packages/*/node_modules",
    "docs:dev": "pnpm --filter nostromo-ui-docs dev",
    "docs:build": "pnpm --filter nostromo-ui-docs build",
    "docs:serve": "pnpm --filter nostromo-ui-docs start",
    "analyze": "ANALYZE=true turbo run build",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "validate:theme-contrasts": "tsx scripts/validate-theme-contrasts.ts",
    "validate:exports": "tsx scripts/validate-exports.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/publish-package.mjs",
    "prepare": "husky",
    "verify:react-compat": "node scripts/verify-react-compat.mjs"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@adobe/css-tools": "^4.5.0",
    "@babel/runtime": "^7.29.7",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@jest/diff-sequences": "^30.4.0",
    "@jest/get-type": "^30.1.0",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@storybook/icons": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/expect": "^4.1.10",
    "@vitest/pretty-format": "^4.1.10",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "@vitest/spy": "^4.1.10",
    "@vitest/utils": "^4.1.10",
    "ansi-styles": "^6.2.3",
    "aria-hidden": "^1.2.6",
    "bundle-analyzer": "^0.0.6",
    "chai": "^6.2.2",
    "chalk": "^5.6.2",
    "css.escape": "^1.5.1",
    "detect-node-es": "^1.1.0",
    "error": "link:@vitest/utils/error",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "get-nonce": "^1.0.1",
    "husky": "^9.1.7",
    "indent-string": "^5.0.0",
    "jest-diff": "^30.4.1",
    "jest-matcher-utils": "^30.4.1",
    "js-tokens": "^10.0.0",
    "lint-staged": "^16.4.0",
    "lodash.merge": "^4.6.2",
    "loupe": "^3.2.1",
    "lz-string": "^1.5.0",
    "magic-string": "^0.30.21",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "pretty-format": "^30.4.1",
    "react-is": "18.2.0",
    "react-remove-scroll": "^2.7.2",
    "react-remove-scroll-bar": "^2.3.8",
    "react-style-singleton": "^2.2.3",
    "redent": "^4.0.0",
    "source-map": "link:@vitest/utils/source-map",
    "std-env": "^3.10.0",
    "strip-indent": "^4.1.1",
    "strip-literal": "^3.1.0",
    "tinyrainbow": "^3.1.1",
    "tinyspy": "^4.0.4",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "use-callback-ref": "^1.3.3",
    "use-sidecar": "^1.1.3",
    "use-sync-external-store": "^1.6.0",
    "utils": "link:@vitest/runner/utils",
    "vite": "^7.3.6"
  }
}
