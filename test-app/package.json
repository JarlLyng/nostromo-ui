{
  "name": "nostromo-ui-smoke",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Consumes the built package the way a real project does, so failures that only show up outside the library's own test environment get caught.",
  "scripts": {
    "test": "vitest run",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@jarllyng/nostromo": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
