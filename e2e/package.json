    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
