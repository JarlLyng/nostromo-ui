    "@next/mdx": "^16.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.0.0",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.26",
    "react-hook-form": "^7.88.0",
    "react-live": "^4.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
